# Database connection string
# For SQLite (default, zero configuration):
DATABASE_URL=sqlite:///./data_visualization.db

# For MySQL:
# DATABASE_URL=mysql+mysqldb://root:yourpassword@localhost/data_visualization

# Secret key for JWT authentication
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production
JWT_ALGORITHM=HS256

# Allowed origins for CORS (default "*")
ORIGINS=*
